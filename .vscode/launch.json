{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch gomuks",
            "type": "go",
            "request": "launch",
            "mode": "auto", // Or "debug"
            "program": "${workspaceFolder}/cmd/gomuks", // This points to your main package
            "env": {
                // Include your CGO flags here if you previously added them to your shell profile
                // This ensures VS Code uses them consistently for building and debugging
                "CGO_CFLAGS": "-I/opt/homebrew/include",
                "CGO_LDFLAGS": "-L/opt/homebrew/lib"
            },
            "args": []
        }
    ]
}